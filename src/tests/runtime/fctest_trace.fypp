! This File contains Unit Tests for testing the
! C++ / Fortran Interfaces to the Mesh Datastructure
! @author Willem Deconinck

#include "fckit/fctest.h"
#include "atlas/atlas_f.h"
#:include "atlas/atlas_f.fypp"

! -----------------------------------------------------------------------------

module fcta_trace_fixture
use atlas_module
use, intrinsic :: iso_c_binding
#if ATLAS_HAVE_OMP
use omp_lib, only: omp_get_num_threads
#endif
@:ENABLE_ATLAS_MACROS()
implicit none
interface
  function trace_stack_size() bind(C, name="atlas_test_trace_stack_size") result(size)
    import c_size_t
    integer(c_size_t) :: size
  end function
  function trace_report_contains(text) bind(C, name="atlas_test_trace_report_contains") result(found)
    import c_char, c_int
    character(c_char), intent(in) :: text(*)
    integer(c_int) :: found
  end function
  function trace_report_excludes(title, label) bind(C, name="atlas_test_trace_report_excludes") result(excluded)
    import c_char, c_int
    character(c_char), intent(in) :: title(*), label(*)
    integer(c_int) :: excluded
  end function
  function trace_report_contains_view(text, length) bind(C, name="atlas_test_trace_report_contains_view") result(found)
    import c_char, c_int, c_size_t
    character(c_char), intent(in) :: text(*)
    integer(c_size_t), value :: length
    integer(c_int) :: found
  end function
end interface
contains
end module

! -----------------------------------------------------------------------------

TESTSUITE_WITH_FIXTURE(fctest_atlas_trace,fcta_trace_fixture)

! -----------------------------------------------------------------------------

subroutine sub2()
  type(atlas_Trace) :: trace
  @:ATLAS_TRACE_BEGIN( trace, "sub2" )
  FCTEST_CHECK( trace%running() )
  @:ATLAS_TRACE_END( trace )
end subroutine

subroutine sub1()
  integer :: i
  type(atlas_Trace) :: trace
  trace = @{ ATLAS_TRACE( "sub1" ) }@
  FCTEST_CHECK( trace%running() )

  do i=1,10
    call sub2()
  enddo

  call trace%final()
end subroutine

TESTSUITE_INIT
  call atlas_library%initialise()
END_TESTSUITE_INIT

! -----------------------------------------------------------------------------

TESTSUITE_FINALIZE
  use fckit_main_module
  call atlas_library%finalise()
END_TESTSUITE_FINALIZE

! -----------------------------------------------------------------------------

TEST( test_trace )
implicit none

  type(atlas_Trace) :: trace

  trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"test_trace")

  FCTEST_CHECK( trace%running() )

  call sub1()

  call trace%stop()
  FCTEST_CHECK( .not. trace%running() )

  call trace%final()


END_TEST
! -----------------------------------------------------------------------------

TEST( test_trace_host_associated_ownership )
implicit none
  type(atlas_Trace) :: trace
  integer(c_size_t) :: initial_size

  initial_size = trace_stack_size()
  call assign_host_trace()
  FCTEST_CHECK( trace%running() )
  call trace%final()
  FCTEST_CHECK( trace_stack_size() == initial_size )
contains
  subroutine assign_host_trace()
    trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"host-associated ownership")
  end subroutine
END_TEST
! -----------------------------------------------------------------------------

TEST( test_trace_private_allocatable_ownership )
implicit none
  type(atlas_Trace), allocatable :: trace
  integer(c_size_t) :: initial_size
  integer :: completed, workers

  initial_size = trace_stack_size()
  completed = 0
  workers = 1
!$omp parallel private(trace) reduction(+:completed)
!$omp single
#if ATLAS_HAVE_OMP
  workers = omp_get_num_threads()
#endif
!$omp end single
  allocate(trace)
  trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"private allocatable ownership")
  call trace%pause()
  call trace%resume()
  call trace%final()
  deallocate(trace)
  completed = completed + 1
!$omp end parallel
  FCTEST_CHECK( completed == workers )
  FCTEST_CHECK( trace_stack_size() == initial_size )
END_TEST
! -----------------------------------------------------------------------------

TEST( test_trace_ownership )
implicit none
  type(atlas_Trace) :: trace, copy, empty
  type(atlas_Trace) :: traces(2), copies(2)
  integer :: labels
  integer(c_size_t) :: initial_size

  initial_size = trace_stack_size()

  trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"constructor ownership")
  copy = trace
  call trace%final()
  FCTEST_CHECK( copy%running() )
  call copy%final()
  call copy%final()
  FCTEST_CHECK( copy%is_null() )
  FCTEST_CHECK( trace_stack_size() == initial_size )

  call trace%init("${_FILE_}$",${_LINE_}$,"explicit init")
  copy = trace
  copy = trace
  call trace%final()
  FCTEST_CHECK( copy%running() )
  copy = empty
  FCTEST_CHECK( copy%is_null() )
  FCTEST_CHECK( trace_stack_size() == initial_size )

  traces(1) = atlas_Trace("${_FILE_}$",${_LINE_}$,"array ownership")
  copies = traces
  call traces%final()
  FCTEST_CHECK( copies(1)%running() )
  FCTEST_CHECK( copies(2)%is_null() )
  call copies%final()
  FCTEST_CHECK( trace_stack_size() == initial_size )

  call trace%init("${_FILE_}$",${_LINE_}$,"broadcast ownership")
  traces = trace
  call trace%final()
  call traces(1)%final()
  FCTEST_CHECK( traces(2)%running() )
  call traces(2)%final()
  FCTEST_CHECK( trace_stack_size() == initial_size )

  ! GNU Fortran 10 deallocates the constructor result after the first element.
#if !defined(__GNUC__) || __GNUC__ > 10
  traces = atlas_Trace("${_FILE_}$",${_LINE_}$,"constructor broadcast ownership")
  call traces(1)%final()
  FCTEST_CHECK( traces(2)%running() )
  call traces(2)%final()
  FCTEST_CHECK( trace_stack_size() == initial_size )
#endif

  do labels=1,5
    select case(labels)
    case(1)
      trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"label ownership","one")
    case(2)
      trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"label ownership","one","two")
    case(3)
      trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"label ownership","one","two","three")
    case(4)
      trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"label ownership","one","two","three","four")
    case(5)
      trace = atlas_Trace("${_FILE_}$",${_LINE_}$,"label ownership","one","two","three","four","five")
    end select
    FCTEST_CHECK( trace%running() )
    call trace%final()
    FCTEST_CHECK( trace_stack_size() == initial_size )
  enddo

#if FCKIT_HAVE_FINAL
  block
    type(atlas_Trace) :: scoped
    scoped = atlas_Trace("${_FILE_}$",${_LINE_}$,"automatic finalization")
  end block
  FCTEST_CHECK( trace_stack_size() == initial_size )
  block
    type(atlas_Trace) :: scoped(2)
    scoped(1) = atlas_Trace("${_FILE_}$",${_LINE_}$,"automatic array finalization")
  end block
  FCTEST_CHECK( trace_stack_size() == initial_size )
#endif
END_TEST
! -----------------------------------------------------------------------------

TEST( test_trace_string_views )
implicit none
  type(atlas_Trace) :: trace
  character(len=80) :: file, title, labels(5)
  character(len=20) :: name
  integer :: count, index

  labels(1) = 'view-label-one'
  labels(2) = 'view-label-two'
  labels(3) = 'view-label-three'
  labels(4) = 'view-label-four'
  labels(5) = repeat('z',64)
  do count=0,5
    write(name,'(A,I0)') 'view-title-',count
    file = '/temporary/fortran-view-location.F90'
    title = name
    select case(count)
    case(0)
      call trace%init(file, 4567, title)
    case(1)
      trace = atlas_Trace(file, 4567, title, labels(1))
    case(2)
      trace = atlas_Trace(file, 4567, title, labels(1), labels(2))
    case(3)
      trace = atlas_Trace(file, 4567, title, labels(1), labels(2), labels(3))
    case(4)
      trace = atlas_Trace(file, 4567, title, labels(1), labels(2), labels(3), labels(4))
    case(5)
      trace = atlas_Trace(file, 4567, title, labels(1), labels(2), labels(3), labels(4), labels(5))
    end select
    file = 'overwritten'
    title = 'overwritten'
    call trace%pause()
    call trace%resume()
    call trace%stop()
    call trace%start()
    call trace%final()
    FCTEST_CHECK( trace_report_contains(trim(name)//c_null_char) == 1 )
    FCTEST_CHECK( trace_report_contains('fortran-view-location.F90 +4567'//c_null_char) == 1 )
    do index=1,count
      FCTEST_CHECK( trace_report_excludes(trim(name)//c_null_char, trim(labels(index))//c_null_char) == 1 )
    enddo
  enddo
  trace = atlas_Trace('empty-label.F90', 4568, 'empty-label-title', '')
  call trace%final()
  FCTEST_CHECK( trace_report_contains('empty-label-title'//c_null_char) == 1 )
  FCTEST_CHECK( trace_report_excludes('empty-label-title'//c_null_char, c_null_char) == 1 )
  call trace%init('empty-title.F90', 4569, '')
  FCTEST_CHECK( trace%running() )
  call trace%final()
  title = 'before'//c_null_char//'after'
  call trace%init('embedded-null.F90', 4570, title)
  call trace%final()
  FCTEST_CHECK( trace_report_contains_view(title, len_trim(title, kind=c_size_t)) == 1 )
END_TEST
! -----------------------------------------------------------------------------

recursive subroutine exercise_trace_ownership(trace, completed)
  type(atlas_Trace), intent(in) :: trace
  integer, intent(inout) :: completed
  type(atlas_Trace) :: copy
  integer :: i

  do i=1,4096
    copy = trace
    completed = completed + 1
    call copy%final()
  enddo
end subroutine

TEST( test_trace_concurrent_ownership )
implicit none
  type(atlas_Trace) :: trace
  integer(c_size_t) :: initial_size
  integer :: completed, workers

  initial_size = trace_stack_size()
  call trace%init("${_FILE_}$",${_LINE_}$,"concurrent shared ownership")
  completed = 0
  workers = 1
!$omp parallel reduction(+:completed)
!$omp single
#if ATLAS_HAVE_OMP
  workers = omp_get_num_threads()
#endif
!$omp end single
  call exercise_trace_ownership(trace, completed)
!$omp end parallel
  FCTEST_CHECK( completed == 4096 * workers )
  FCTEST_CHECK( trace%running() )
  call trace%final()
  FCTEST_CHECK( trace_stack_size() == initial_size )
END_TEST
! -----------------------------------------------------------------------------

END_TESTSUITE

